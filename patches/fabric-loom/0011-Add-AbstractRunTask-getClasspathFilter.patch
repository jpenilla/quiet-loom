From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Penilla <11360596+jpenilla@users.noreply.github.com>
Date: Tue, 21 Jan 2025 13:15:14 -0700
Subject: [PATCH] Add AbstractRunTask#getClasspathFilter


diff --git a/src/main/java/net/fabricmc/loom/task/AbstractRunTask.java b/src/main/java/net/fabricmc/loom/task/AbstractRunTask.java
index 9a7d07b09e4feb9da9c0b5977239a21c5dbfcd09..801003d708d47c1ec64c93f1f143de983dc2a06f 100644
--- a/src/main/java/net/fabricmc/loom/task/AbstractRunTask.java
+++ b/src/main/java/net/fabricmc/loom/task/AbstractRunTask.java
@@ -35,6 +35,7 @@ import java.nio.file.Paths;
 import java.util.ArrayList;
 import java.util.List;
 import java.util.function.Function;
+import java.util.function.Predicate;
 import java.util.stream.Collectors;
 
 import javax.inject.Inject;
@@ -136,6 +137,10 @@ public abstract class AbstractRunTask extends JavaExec {
 	@Classpath
 	protected abstract ConfigurableFileCollection getInternalClasspath();
 
+	@Input
+	@Optional
+	public abstract Property<Predicate<File>> getClasspathFilter();
+
 	public AbstractRunTask(Function<Project, RunConfiguration> configProvider) {
 		super();
 		setGroup(Constants.TaskGroup.FABRIC);
@@ -221,8 +226,8 @@ public abstract class AbstractRunTask extends JavaExec {
 			super.setClasspath(getObjectFactory().fileCollection());
 		} else {
 			LOGGER.debug("Using bare classpath for {}", getName());
-			// The classpath is passed normally, so pass the full classpath to the super JavaExec.
-			super.setClasspath(getInternalClasspath());
+			// The classpath is passed normally, so pass the filtered classpath to the super JavaExec.
+			super.setClasspath(getInternalClasspath().filter(this::includeClasspathEntry));
 		}
 
 		setWorkingDir(getInternalRunDir());
@@ -331,6 +336,7 @@ public abstract class AbstractRunTask extends JavaExec {
 
 	private void writeArgFile() {
 		final String content = "-classpath\n" + this.getInternalClasspath().getFiles().stream()
+				.filter(this::includeClasspathEntry)
 				.map(File::getAbsolutePath)
 				.map(AbstractRunTask::quoteArg)
 				.collect(Collectors.joining(File.pathSeparator));
@@ -344,6 +350,10 @@ public abstract class AbstractRunTask extends JavaExec {
 		}
 	}
 
+	private boolean includeClasspathEntry(File file) {
+		return !getClasspathFilter().isPresent() || getClasspathFilter().get().test(file);
+	}
+
 	// Based off https://github.com/JetBrains/intellij-community/blob/295dd68385a458bdfde638152e36d19bed18b666/platform/util/src/com/intellij/execution/CommandLineWrapperUtil.java#L87
 	private static String quoteArg(String arg) {
 		final String specials = " #'\"\n\r\t\f";
diff --git a/src/test/groovy/net/fabricmc/loom/test/integration/RunClasspathFilterTest.groovy b/src/test/groovy/net/fabricmc/loom/test/integration/RunClasspathFilterTest.groovy
new file mode 100644
index 0000000000000000000000000000000000000000..90150c1db9200210ddf57c08c866f1fd16657c7f
--- /dev/null
+++ b/src/test/groovy/net/fabricmc/loom/test/integration/RunClasspathFilterTest.groovy
@@ -0,0 +1,47 @@
+package net.fabricmc.loom.test.integration
+
+import spock.lang.Specification
+
+import net.fabricmc.loom.test.util.GradleProjectTestTrait
+
+import static net.fabricmc.loom.test.LoomTestConstants.DEFAULT_GRADLE
+import static org.gradle.testkit.runner.TaskOutcome.FAILED
+
+class RunClasspathFilterTest extends Specification implements GradleProjectTestTrait {
+	def "filters entries from a run task classpath"() {
+		given:
+		def gradle = gradleProject(project: "runconfigs", version: DEFAULT_GRADLE)
+		gradle.buildGradle << '''
+
+tasks.named('runCustomMain') {
+	classpathFilter.set({ File file -> !file.isDirectory() } as java.util.function.Predicate<File>)
+}
+'''
+
+		when:
+		def result = gradle.run(tasks: ["runCustomMain"], expectFailure: true)
+
+		then:
+		result.task(":runCustomMain").outcome == FAILED
+		result.output.contains("net.fabricmc.example.Main")
+	}
+
+	def "filters entries from a run task classpath without an arg file"() {
+		given:
+		def projectDir = File.createTempDir("loom-", "-非ascii")
+		def gradle = gradleProject(project: "runconfigs", version: DEFAULT_GRADLE, projectDir: projectDir)
+		gradle.buildGradle << '''
+
+tasks.named('runCustomMain') {
+	classpathFilter.set({ File file -> !file.isDirectory() } as java.util.function.Predicate<File>)
+}
+'''
+
+		when:
+		def result = gradle.run(tasks: ["runCustomMain"], expectFailure: true)
+
+		then:
+		result.task(":runCustomMain").outcome == FAILED
+		result.output.contains("net.fabricmc.example.Main")
+	}
+}
