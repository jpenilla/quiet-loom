@@ -87,10 +98,24 @@ public final class IncludeConfigurations {
 
 	private static TaskProvider<NestableJarGenerationTask> createProcessTask(Project project, Provider<? extends Configuration> configuration, String taskName) {
 		Configuration internalConfiguration = createInternalConfiguration(project, configuration);
+		return createProcessTask(project, taskName, task -> task.from(internalConfiguration));
+	}
+
+	private static TaskProvider<NestableJarGenerationTask> createDefaultProcessTask(Project project, String taskName) {
