+package net.fabricmc.loom.test.integration
+
+import java.util.zip.ZipFile
+
+import groovy.json.JsonSlurper
+import spock.lang.Specification
+import spock.lang.Unroll
+
+import net.fabricmc.loom.test.util.GradleProjectTestTrait
+
+import static net.fabricmc.loom.test.LoomTestConstants.DEFAULT_GRADLE
+import static org.gradle.testkit.runner.TaskOutcome.SUCCESS
+
+class IncludeConfigurationOverlapTest extends Specification implements GradleProjectTestTrait {
+	@Unroll
+	def "de-duplicates dependencies shared by include configurations for #project"() {
+		given:
+		def gradle = gradleProject(project: project, version: DEFAULT_GRADLE)
+		gradle.buildGradle << '''
+
+dependencies {
+	// Also resolved transitively through jackson-databind.
+	include 'com.fasterxml.jackson.core:jackson-core:2.16.1'
+}
+'''
+
+		when:
+		def result = gradle.run(tasks: [task])
+
+		then:
+		result.task(":$task").outcome == SUCCESS
+		def nestedPath = "META-INF/jars/jackson-core-2.16.1.jar"
+		zipEntryCount(gradle.getOutputFile("includedJars.jar"), nestedPath) == 1
+		def fabricModJson = new JsonSlurper().parseText(gradle.getOutputZipEntry("includedJars.jar", "fabric.mod.json"))
+		fabricModJson.jars.count { it.file == nestedPath } == 1
+
+		where:
+		project                 | task
+		"includedJars"          | "remapJar"
+		"includedJarsNoRemap"   | "jar"
+	}
+
+	private static long zipEntryCount(File file, String name) {
+		return new ZipFile(file).withCloseable { zip ->
+			zip.stream().filter { entry -> entry.name == name }.count()
+		}
+	}
+}
