From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Penilla <11360596+jpenilla@users.noreply.github.com>
Date: Tue, 21 Jan 2025 13:15:14 -0700
Subject: [PATCH] Add AbstractRunTask#getClasspathFilter


diff --git a/src/main/java/net/fabricmc/loom/task/AbstractRunTask.java b/src/main/java/net/fabricmc/loom/task/AbstractRunTask.java
index 8a0a4b72d315969bcb03154a84ae9325fbe9b99f..e54d6a6d9d0bb0481ca9ae823eca81b5814a568a 100644
--- a/src/main/java/net/fabricmc/loom/task/AbstractRunTask.java
+++ b/src/main/java/net/fabricmc/loom/task/AbstractRunTask.java
@@ -35,6 +35,7 @@ import java.nio.file.Paths;
 import java.util.ArrayList;
 import java.util.List;
 import java.util.function.Function;
+import java.util.function.Predicate;
 import java.util.stream.Collectors;
 
 import org.gradle.api.Project;
@@ -48,6 +49,7 @@ import org.gradle.api.specs.Spec;
 import org.gradle.api.tasks.Input;
 import org.gradle.api.tasks.InputFiles;
 import org.gradle.api.tasks.JavaExec;
+import org.gradle.api.tasks.Optional;
 import org.jetbrains.annotations.NotNull;
 import org.slf4j.Logger;
 import org.slf4j.LoggerFactory;
@@ -78,6 +80,10 @@ public abstract class AbstractRunTask extends JavaExec {
 	@InputFiles
 	protected abstract ConfigurableFileCollection getInternalClasspath();
 
+	@Input
+	@Optional
+	public abstract Property<Predicate<File>> getClasspathFilter();
+
 	public AbstractRunTask(Function<Project, RunConfig> configProvider) {
 		super();
 		setGroup(Constants.TaskGroup.FABRIC);
@@ -152,6 +158,12 @@ public abstract class AbstractRunTask extends JavaExec {
 
 		if (getUseArgFile().get()) {
 			final String content = "-classpath\n" + this.getInternalClasspath().getFiles().stream()
+					.filter(f -> {
+						if (this.getClasspathFilter().isPresent()) {
+							return this.getClasspathFilter().get().test(f);
+						}
+						return true;
+					})
 					.map(File::getAbsolutePath)
 					.map(AbstractRunTask::quoteArg)
 					.collect(Collectors.joining(File.pathSeparator));
