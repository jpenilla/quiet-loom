+package net.fabricmc.loom.task;
+
+import java.util.List;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+import org.gradle.api.Action;
+import org.gradle.api.Project;
+import org.gradle.api.tasks.TaskProvider;
+import org.gradle.api.tasks.bundling.AbstractArchiveTask;
+
+final class ShadowPluginSupport {
+	static final String SHADOW_JAR_TASK_NAME = "shadowJar";
+
+	private static final List<String> SHADOW_PLUGIN_IDS = List.of(
+			"com.github.johnrengelman.shadow",
+			"io.github.goooler.shadow",
+			"com.gradleup.shadow"
+	);
+
+	private ShadowPluginSupport() {
+	}
+
+	static void withShadowJar(Project project, Action<TaskProvider<AbstractArchiveTask>> action) {
+		AtomicBoolean configured = new AtomicBoolean();
+
+		for (String pluginId : SHADOW_PLUGIN_IDS) {
+			project.getPlugins().withId(pluginId, plugin -> {
+				if (configured.compareAndSet(false, true)) {
+					action.execute(project.getTasks().named(SHADOW_JAR_TASK_NAME, AbstractArchiveTask.class));
+				}
+			});
+		}
+	}
+}
diff --git a/src/test/groovy/net/fabricmc/loom/test/integration/ShadowIntegrationTest.groovy b/src/test/groovy/net/fabricmc/loom/test/integration/ShadowIntegrationTest.groovy
new file mode 100644
index 0000000000000000000000000000000000000000..11f58231b956f318fb4b1bf10e9bd6f231fa16d8
--- /dev/null
+++ b/src/test/groovy/net/fabricmc/loom/test/integration/ShadowIntegrationTest.groovy
@@ -0,0 +1,59 @@
+package net.fabricmc.loom.test.integration
+
+import spock.lang.Specification
+
+import net.fabricmc.loom.test.util.GradleProjectTestTrait
+
+import static net.fabricmc.loom.test.LoomTestConstants.DEFAULT_GRADLE
+import static org.gradle.testkit.runner.TaskOutcome.SUCCESS
+
+class ShadowIntegrationTest extends Specification implements GradleProjectTestTrait {
+	private static final String SHADOW_PLUGIN = "id 'com.gradleup.shadow' version '9.5.1'"
+	private static final String SHADED_DEPENDENCY = "shadowTest 'org.apache.commons:commons-lang3:3.14.0'"
+
+	def "remaps the shadow jar"() {
+		given:
+		def gradle = gradleProject(project: "includedJars", version: DEFAULT_GRADLE)
+		addShadow(gradle)
+
+		when:
+		def result = gradle.run(tasks: ["assemble"])
+
+		then:
+		result.task(":shadowJar").outcome == SUCCESS
+		result.task(":remapJar").outcome == SUCCESS
+		gradle.hasOutputZipEntry("includedJars.jar", "org/apache/commons/lang3/StringUtils.class")
+		gradle.hasOutputZipEntry("includedJars.jar", "META-INF/jars/log4j-core-2.22.0.jar")
+		gradle.hasOutputZipEntry("includedJars.jar", "META-INF/jars/jackson-core-2.16.1.jar")
+	}
+
+	def "builds the shadow jar without remapping"() {
+		given:
+		def gradle = gradleProject(project: "includedJarsNoRemap", version: DEFAULT_GRADLE)
+		addShadow(gradle)
+
+		when:
+		def result = gradle.run(tasks: ["assemble"])
+
+		then:
+		result.task(":shadowJar").outcome == SUCCESS
+		gradle.hasOutputZipEntry("includedJars-all.jar", "org/apache/commons/lang3/StringUtils.class")
+		gradle.hasOutputZipEntry("includedJars-all.jar", "META-INF/jars/log4j-core-2.22.0.jar")
+		gradle.hasOutputZipEntry("includedJars-all.jar", "META-INF/jars/jackson-core-2.16.1.jar")
+		gradle.getOutputZipEntry("includedJars-all.jar", "META-INF/MANIFEST.MF")
+				.contains("Fabric-Mapping-Namespace: official")
+	}
+
+	private static void addShadow(GradleProjectTestTrait.GradleProject gradle) {
+		gradle.buildGradle.text = gradle.buildGradle.text
+				.replaceFirst(/plugins \{/, "plugins {\n\t${SHADOW_PLUGIN}")
+				.replaceFirst(/repositories \{/, "configurations { shadowTest }\n\nrepositories {")
+				.replaceFirst(/dependencies \{/, "dependencies {\n\t${SHADED_DEPENDENCY}")
+		gradle.buildGradle << '''
+
+shadowJar {
+	configurations = [project.configurations.shadowTest]
+}
+'''
+	}
+}
